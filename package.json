		"@types/mime": "^3.0.4",
		"@types/node": "^24.13.3",
		"@types/postcss-safe-parser": "^5.0.4",
		"@types/rss": "^0.0.32",
		"esbuild": "0.28.1",
		"obsidian": "^1.13.1",
